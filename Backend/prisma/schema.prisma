generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String

  resumes Resume[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resume {
  id String @id @default(cuid())

  fileName String
  fileUrl  String

  extractedText String? @db.Text

  // Original Resume
  atsScore Int?
  analysis Json?

  // Improved Resume
  improvedScore Int?
  improvedResume String? @db.Text
  improvedAnalysis Json?

  status String @default("uploaded")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}